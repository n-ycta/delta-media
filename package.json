{
  "name": "delta-media",
  "version": "0.3.6",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs && node tests/search-actions.browser.mjs && node tests/offline.browser.mjs",
    "package:app": "npm run build && node scripts/package-app.mjs",
    "package:plugin": "npm run package:app && node scripts/package-plugin.mjs",
    "test:api": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "playwright": "^1.63.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@delta/ui": "https://github.com/n-ycta/delta-ui/archive/8307328d23737d9208601a772f1464e62550a8d4.tar.gz",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/literata": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/onest": "^5.3.1",
    "@phosphor-icons/core": "^2.1.1"
  }
}
